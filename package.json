{
  "name": "zcode-cli",
  "version": "0.1.0",
  "description": "ZCode CLI — terminal coding agent for GLM models on z.ai and bigmodel.cn. Not an official z.ai product.",
  "type": "module",
  "bin": {
    "zcode-cli": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "boundary": "bun run scripts/check-llm-boundary.ts",
    "test": "bun test",
    "check": "bun run typecheck && bun run boundary && bun test",
    "build": "bun build --compile --outfile dist/zcode-cli src/index.ts",
    "format": "prettier --write src test scripts"
  },
  "keywords": [
    "zcode",
    "glm",
    "cli",
    "agent",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "Yijiazhen Qi",
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "ai": "6.0.168",
    "commander": "15.0.0",
    "ink": "6.7.0",
    "react": "19.2.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.4",
    "typescript": "5.9.3"
  }
}
